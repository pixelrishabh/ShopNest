{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Start ShopNest (One Go)",
      "type": "shell",
      "windows": {
        "command": ".\\start.bat"
      },
      "command": "npm run dev",
      "isBackground": true,
      "problemMatcher": {
        "pattern": {
          "regexp": "."
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "Starting ShopNest",
          "endsPattern": "Ready in|Local:"
        }
      },
      "group": {
        "kind": "build",
        "isDefault": true
      }
    }
  ]
}
