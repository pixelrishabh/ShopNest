# Database (PostgreSQL)
DATABASE_URL="postgresql://shopnest_user:shopnest_password@localhost:5432/shopnest?schema=public"

# Auth Secret & App URL
AUTH_SECRET="your-super-secret-auth-key-at-least-32-chars-long"
NEXTAUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Razorpay Test Credentials
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_placeholder_key"
RAZORPAY_KEY_SECRET="placeholder_secret_key"
RAZORPAY_WEBHOOK_SECRET="placeholder_webhook_secret"

# Seller State Code (for Indian GST: intrastate CGST+SGST vs interstate IGST)
SELLER_STATE="MH"
SELLER_PIN="400001"
SELLER_STORE_NAME="ShopNest Retail Private Limited"
SELLER_GSTIN="27AAACS1234A1Z5"

# Mailer (optional - if omitted or blank, console mailer logs without failure)
RESEND_API_KEY=""
EMAIL_FROM="orders@shopnest.local"

# Redis (optional - in-memory rate limiter used if omitted)
REDIS_URL=""

# Seed Credentials
SEED_ADMIN_EMAIL="admin@shopnest.in"
SEED_ADMIN_PASSWORD="AdminPassword123!"
SEED_CUSTOMER_EMAIL="customer@shopnest.in"
SEED_CUSTOMER_PASSWORD="CustomerPassword123!"
